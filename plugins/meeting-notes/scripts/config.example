# meeting-notes 설정 — ~/.config/meetingrec/config 로 복사해서 쓴다
# (셸 스크립트로 source 되므로 KEY=VALUE 형식)

# 녹음·업로드 작업 폴더
RECORDINGS_DIR="$HOME/recordings"

# 업로드 대상 (rclone 원격). 먼저 `rclone config` 로 원격을 만들어야 한다.
#   예) 구글드라이브 폴더 하나를 alias 로 잡아두면 가장 단순하다:
#     rclone config create gdrive drive scope=drive
#     rclone config create meetings alias remote "gdrive,root_folder_id=<폴더ID>:"
#   그러면 UPLOAD_DEST="meetings:" 로 두면 된다.
#   폴더 ID 는 Drive 폴더 URL 의 /folders/ 뒤 문자열이다.
UPLOAD_DEST="meetings:"

# 마이크 장치 UID. 장치 이름은 OS 언어에 따라 달라지므로 UID 로 지정한다.
#   내장 마이크는 어느 맥이든 BuiltInMicrophoneDevice 다.
#   목록 확인: scripts/audiodev list   (이름 / UID / 입력채널 / 출력채널)
MIC_UID="BuiltInMicrophoneDevice"

# 녹음 비트레이트 (STT 용도로는 96k 면 충분하다)
AUDIO_BITRATE="96k"

# 업로드 전 최소 길이(초). 이보다 짧으면 녹음 사고로 보고 failed/ 로 격리한다.
MIN_DURATION="5"

# launchd 업로드 작업 라벨 (install.sh 가 설치하는 것과 같아야 한다)
UPLOAD_LABEL="com.meetingrec.upload"

# Soniox API 키는 여기 두지 말고 셸 환경변수로 export 한다:
#   export SONIOX_API_KEY=...
